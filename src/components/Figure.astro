---
interface Props {
  /** Path under /public, e.g. /projects/mario/vision.mp4 */
  src: string;
  alt: string;
  /** Intrinsic size; reserves the box so loading media does not shift the page */
  width: number;
  height: number;
  /** Rendered below the media; supports inline markup via the default slot instead */
  caption?: string;
  /** Pixel-art media is upscaled with nearest-neighbour so it stays crisp */
  pixelated?: boolean;
  /** Hero figures load eagerly, everything else waits until it scrolls into view */
  eager?: boolean;
}
const { src, alt, width, height, caption, pixelated = true, eager = false } = Astro.props;
const isVideo = src.endsWith('.mp4');
---

<figure class="my-8">
  {
    isVideo ? (
      <video
        src={src}
        width={width}
        height={height}
        class:list={[
          'w-full h-auto rounded-lg border border-[var(--color-border)]',
          pixelated && 'pixelated',
        ]}
        aria-label={alt}
        muted
        loop
        playsinline
        preload={eager ? 'auto' : 'none'}
        data-autoplay-in-view
      />
    ) : (
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class:list={[
          'w-full h-auto rounded-lg border border-[var(--color-border)]',
          pixelated && 'pixelated',
        ]}
      />
    )
  }
  {
    (caption || Astro.slots.has('default')) && (
      <figcaption class="mt-3 text-sm text-[var(--color-fg-dim)] leading-relaxed">
        {caption}
        <slot />
      </figcaption>
    )
  }
</figure>

<style>
  .pixelated {
    image-rendering: pixelated;
    background-color: var(--color-surface);
  }
</style>

<script>
  // Only play what is actually on screen: a project page carries several clips,
  // and letting them all run at once burns battery for nothing.
  function initInViewVideos() {
    const videos = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay-in-view]');
    if (!videos.length) return;

    // Looping clips are motion the visitor did not ask for; leave them on the
    // first frame and give them controls instead.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      videos.forEach((video) => {
        video.preload = 'metadata';
        video.controls = true;
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            video.play().catch(() => {
              // Low-power mode and some strict settings refuse autoplay outright.
              // Without controls the visitor would be left with a frozen frame.
              video.controls = true;
            });
          } else {
            video.pause();
          }
        }
      },
      { rootMargin: '200px 0px' },
    );

    videos.forEach((video) => observer.observe(video));
  }

  initInViewVideos();
  document.addEventListener('astro:page-load', initInViewVideos);
</script>
